[h: assert(isGM(), "Somente o mestre pode adicionar tokens por este painel.", 0)]
[h: req = macro.args]
[h: asset = json.get(req, "asset")]
[h: assert(length(asset) == 5, "Imagem de token inválida.", 0)]
[h: prefix = substring(asset, 0, 1)]
[h: assert(prefix == "t" || prefix == "p", "Coleção de tokens inválida.", 0)]
[h: assetNumber = number(substring(asset, 1))]
[h: maxNumber = if(prefix == "p", 72, 680)]
[h: assert(assetNumber >= 1 && assetNumber <= maxNumber && assetNumber == floor(assetNumber), "Token fora do catálogo.", 0)]
[h: canonical = strformat(prefix + "%04d", assetNumber)]
[h: assert(asset == canonical, "Identificador de token inválido.", 0)]
[h: name = json.get(req, "name")]
[h: assert(length(name) > 0 && length(name) <= 100, "Nome de token inválido.", 0)]
[h: center = getViewCenter(0, "json")]
[h: countExisting = json.length(getTokens("json"))]
[h: x = json.get(center, "centerX") + countExisting - floor(countExisting / 5) * 5 - 2]
[h: y = json.get(center, "centerY") + floor((countExisting - floor(countExisting / 25) * 25) / 5) - 2]
[h: folder = if(prefix == "p", "portraits/", "tokens/")]
[h: id = createToken(json.set("{}", "name", name, "tokenImage", "lib://local.sexored.red/" + folder + asset + ".png", "layer", "TOKEN", "x", x, "y", y))]
[h, if(json.get(req, "type") == "PC"): setPC(id); setNPC(id)]
[h: macro.return = json.set("{}", "ok", 1, "id", id)]
