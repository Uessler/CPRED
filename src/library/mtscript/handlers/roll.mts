[h: req = macro.args]
[h: id = json.get(req, "id")]
[h: first = 1d10]
[h: extra = 0]
[h, if(first == 1 || first == 10): extra = 1d10]
[h: die = first + if(first == 1, -extra, extra)]
[h: base = json.get(req, "base")]
[h: mod = json.get(req, "modifier")]
[h: total = die + base + mod]
[h: label = json.get(req, "label")]
[h: safeLabel = replace(replace(replace(label, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")]
[h: safeName = replace(replace(replace(getName(id), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")]
[h: text = "<b>" + safeName + " · " + safeLabel + "</b><br>d10: " + first + if(extra > 0, if(first == 1, " − ", " + ") + extra, "") + " | Base: " + base + " | Mod: " + mod + "<br><b>Total: " + total + "</b>"]
[h: broadcast(text)]
[h: macro.return = json.set("{}", "ok", 1, "first", first, "extra", extra, "total", total)]
