[h: req = macro.args]
[h: n = json.get(req, "count")]
[h: bonus = json.get(req, "bonus")]
[h: assert(n >= 1 && n <= 20 && n == floor(n) && abs(bonus) <= 999, "Expressão de dano inválida.", 0)]
[h: dice = "[]"]
[h: total = bonus]
[h: sixes = 0]
[h, count(n), code: {
  [h: d = 1d6]
  [h: dice = json.append(dice, d)]
  [h: total = total + d]
  [h: sixes = sixes + if(d == 6, 1, 0)]
}]
[h: total = max(0, total)]
[h: label = json.get(req, "label")]
[h: safeLabel = replace(replace(replace(label, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")]
[h: broadcast("<b>Dano · " + safeLabel + ": " + total + "</b><br>Dados: " + dice + " | Bônus: " + bonus + if(sixes >= 2, "<br>Dois ou mais seis: confira ferimento crítico e dano adicional conforme as regras.", ""))]
[h: macro.return = json.set("{}", "ok", 1, "dice", dice, "total", total, "bonus", bonus, "critical", if(sixes >= 2, 1, 0))]
