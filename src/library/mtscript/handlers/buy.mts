[h: req = macro.args]
[h: id = json.get(req, "id")]
[h: itemId = json.get(req, "itemId")]
[h: qty = json.get(req, "qty")]
[h: transaction = json.get(req, "transaction")]
[h: result = json.set("{}", "ok", 0, "error", "Compra inválida.")]
[h: valid = qty >= 1 && qty <= 99 && qty == floor(qty) && length(transaction) > 0 && length(transaction) <= 128]
[h, macro("market/catalog@this"): ""]
[h: catalog = macro.return]
[h: valid = valid && json.contains(catalog, itemId)]
[h, if(valid), code: {
  [h: item = json.get(catalog, itemId)]
  [h: valid = json.get(item, "buyable") == 1]
  [h, if(!valid): result = json.set(result, "error", "Preço variável ou pendente de conferência. Consulte a referência.")]
}]
[h, if(valid), code: {
  [h: data = getProperty("SEXORED", id)]
  [h: valid = json.type(data) == "OBJECT"]
  [h, if(!valid): result = json.set(result, "error", "Salve a ficha antes de comprar.")]
}]
[h, if(valid), code: {
  [h: receipts = json.get(data, "purchases")]
  [h, if(json.type(receipts) != "ARRAY"): receipts = "[]"]
  [h: duplicate = 0]
  [h, foreach(receipt, receipts): duplicate = duplicate || json.get(receipt, "transaction") == transaction]
  [h, if(duplicate): result = json.set("{}", "ok", 1, "data", data, "duplicate", 1)]
  [h: valid = !duplicate]
}]
[h, if(valid), code: {
  [h: price = json.get(item, "price")]
  [h: total = price * qty]
  [h: cash = json.get(data, "cash")]
  [h: valid = cash >= total]
  [h, if(!valid): result = json.set(result, "error", "Eurobucks insuficientes para esta compra.")]
}]
[h, if(valid), code: {
  [h: inventory = json.get(data, "items")]
  [h, if(json.type(inventory) != "ARRAY"): inventory = "[]"]
  [h: found = -1]
  [h: n = 0]
  [h, foreach(entry, inventory), code: {
    [h, if(json.get(entry, "catalogId") == itemId): found = n]
    [h: n = n + 1]
  }]
  [h: valid = found >= 0 || json.length(inventory) < 2000]
  [h, if(!valid): result = json.set(result, "error", "Inventário cheio (2.000 entradas).")]
}]
[h, if(valid), code: {
  [h: name = json.get(item, "name")]
  [h, if(found >= 0), code: {
    [h: entry = json.get(inventory, found)]
    [h: entry = json.set(entry, "qty", json.get(entry, "qty") + qty)]
    [h: inventory = json.set(inventory, found, entry)]
  };{
    [h: entry = json.set("{}", "name", name, "qty", qty, "catalogId", itemId, "unitPrice", price, "source", json.get(item, "source"), "kind", json.get(item, "kind"), "unit", json.get(item, "unit"), "notes", json.get(item, "source") + " · " + json.get(item, "unit"))]
    [h: inventory = json.append(inventory, entry)]
  }]
  [h: receipt = json.set("{}", "transaction", transaction, "itemId", itemId, "name", name, "qty", qty, "unitPrice", price, "total", total, "date", json.get(getInfo("client"), "timeDate"))]
  [h: receipts = json.append(receipts, receipt)]
  [h, if(json.length(receipts) > 200): receipts = json.remove(receipts, 0)]
  [h: data = json.set(data, "cash", cash - total, "items", inventory, "purchases", receipts)]
  [h: setProperty("SEXORED", data, id)]
  [h: result = json.set("{}", "ok", 1, "data", data, "receipt", receipt)]
}]
[h: macro.return = result]
